{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "context-os-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "context-os-mcp",
			"database_id": "replace-with-production-d1-id",
			"preview_database_id": "replace-with-preview-d1-id",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "replace-with-production-kv-id",
			"preview_id": "replace-with-preview-kv-id"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "INDEX_QUEUE",
				"queue": "context-os-index-queue"
			}
		],
		"consumers": [
			{
				"queue": "context-os-index-queue",
				"max_batch_size": 25,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},
	"vectorize": [
		{
			"binding": "MEMORY_INDEX",
			"index_name": "context-os-index",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		"crons": [
			"*/30 * * * *"
		]
	},
	"vars": {
		"APP_BASE_URL": "https://your-worker.your-subdomain.workers.dev",
		"MCP_ROUTE": "/mcp",
		"ZOHO_WORKDRIVE_API_BASE_URL": "https://www.zohoapis.com.au/workdrive/api/v1",
		"ZOHO_ACCOUNTS_BASE_URL": "https://accounts.zoho.com.au",
		"GITHUB_OAUTH_AUTHORIZE_URL": "https://github.com/login/oauth/authorize",
		"GITHUB_OAUTH_TOKEN_URL": "https://github.com/login/oauth/access_token",
		"GITHUB_OAUTH_USER_URL": "https://api.github.com/user",
		"GITHUB_OAUTH_EMAILS_URL": "https://api.github.com/user/emails",
		"GITHUB_API_BASE_URL": "https://api.github.com",
		"GITHUB_OAUTH_SCOPES": "read:user user:email repo",
		"WORKERS_AI_EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
		"DEFAULT_TIMEZONE": "UTC"
	}
}
