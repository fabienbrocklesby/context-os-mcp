# This file is a source-of-truth template for values you will set in:
# 1. Wrangler secrets (`npx wrangler secret put ...`) for sensitive values
# 2. `wrangler.jsonc` / environment-specific vars for non-secret values
# 3. `.dev.vars` locally if you want `wrangler dev` to load secrets during development

# Public base URL for the deployed Worker or custom domain
APP_BASE_URL=https://your-worker.your-subdomain.workers.dev

# MCP route served by the Worker
MCP_ROUTE=/mcp

# Optional comma-separated browser origins allowed to call the remote MCP endpoint
# Leave unset to disable explicit Origin filtering
ALLOWED_ORIGINS=https://chat.openai.com,https://claude.ai

# Optional static bearer token for service-style or non-OAuth clients
MCP_BEARER_TOKEN=replace-with-long-random-token

# Optional comma-separated GitHub logins allowed to call admin-only tools like reindex_all
ADMIN_GITHUB_LOGINS=your-github-login

# Required for the Worker's GitHub-backed login session cookie signing
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars

# GitHub OAuth App credentials used by the MCP server's OAuth login flow
# Create these in GitHub Developer Settings > OAuth Apps
GITHUB_OAUTH_CLIENT_ID=replace-with-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_USER_URL=https://api.github.com/user
GITHUB_OAUTH_EMAILS_URL=https://api.github.com/user/emails

# GitHub repository tools use the signed-in GitHub OAuth account. The `repo`
# scope allows private personal and organization repos that your account can
# access, subject to organization OAuth policies.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_OAUTH_SCOPES=read:user user:email repo
# Optional fallback token for local/dev automation. Prefer /login/github.
GITHUB_ACCESS_TOKEN=
# Optional comma-separated allowlist. Leave blank to allow every repo visible to
# the connected GitHub OAuth account.
GITHUB_ALLOWED_REPOS=owner/repo,org/private-repo

# Zoho Accounts + WorkDrive endpoints
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_WORKDRIVE_API_BASE_URL=https://workdrive.zoho.com/api/v1

# Required for write operations. This is intentionally an explicit env var because
# the exact upload endpoint should be verified against your WorkDrive tenant via
# Zoho's official API explorer before production rollout.
ZOHO_WORKDRIVE_UPLOAD_URL=https://<verified-zoho-upload-endpoint>

# Choose either a short-lived static access token for experimentation OR the refresh flow.
# Production should prefer the refresh flow.
ZOHO_ACCESS_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Workers AI embedding model. Default in code already matches this value.
WORKERS_AI_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Root folders that contain the canonical markdown memory tree in WorkDrive
WORKDRIVE_SHARED_ROOT_FOLDER_ID=
WORKDRIVE_PROJECTS_ROOT_FOLDER_ID=
